# Copy to .env (gitignored). docker-compose.yml reads it.

# Tailscale auth key for Vesper's own tailnet node (https://login.tailscale.com/admin/settings/keys).
# Reusable + ephemeral off is simplest for a long-lived home server.
TS_AUTHKEY=tskey-auth-...

# Host folder where Vesper keeps every entry (transcript .txt + audio, one subfolder per day).
# An Obsidian vault folder works well. Point it at an empty folder to start fresh.
VESPER_VAULT_DIR=C:/path/to/vault/Recordings
