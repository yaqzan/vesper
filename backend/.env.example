WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
# Compute type must match your GPU:
#   RTX 20xx and newer (compute 7.0+): float16
#   Pascal GTX 10xx (e.g. 1080 Ti):    int8_float32   (no efficient fp16)
#   CPU only:                          int8
WHISPER_COMPUTE_TYPE=int8_float32
# Optional: primes the model with names/context it might otherwise mishear.
WHISPER_INITIAL_PROMPT=My partner Alex and I...
# Optional: post-processing find/replace for names Whisper still gets wrong,
# even with the prompt above. Format: Wrong:Right,Also Wrong:Right (comma-
# separated, whole-word, case-insensitive). Keep this list narrow — a common
# name used by more than one person in your recordings will get corrupted.
WHISPER_SUBSTITUTIONS=Alec:Alex,Alexa:Alex

# --- Obsidian vault — REQUIRED; this is where the data lives ---
# Path INSIDE the container: docker-compose.yml bind-mounts the vault's
# VESPER_VAULT_DIR folder (root .env) here. There is no database; every entry
# is a <date>/NN - H.MMpm.txt (+ audio) pair in this folder. Point it somewhere
# empty and Vesper starts empty.
VAULT_RECORDINGS_DIR=/vault/recordings
# Vault filenames use local wall-clock time ("6.58pm") while timestamps are
# handled in UTC, so the recording timezone has to be explicit.
VAULT_TZ=America/Toronto

# --- Hardening (reasonable defaults; set a limit to 0 to disable it) ---
# Max accepted audio upload size, in megabytes.
MAX_UPLOAD_MB=50
# Per-IP ceiling on ALL /api requests per minute (blunts brute force + abuse).
RATE_LIMIT_API_PER_MIN=300
# Stricter per-IP ceiling on the expensive transcribe endpoint, per minute.
RATE_LIMIT_TRANSCRIBE_PER_MIN=20
